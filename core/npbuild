#!/bin/sh

# A shell script for building library packages and non-locatable packages for host, which is used by ndk-pkg.
#
# Influential environment variables: CC, AR, RANLIB, CFLAGS, CPPFLAGS, LDFLAGS
#
# Usage: ./npbuild [options] <PACKAGE-NAME>...
#
#    <PACKAGE-NAME> can be any one of libz, libiconv, libxml2, libexpat, libtool, itstool, intltool, texinfo, help2man, automake, autoconf, autoconf_archive, netsurf_buildsystem, perl_XML_Parser
#
#    options:
#
#       -j <N>
#            specify the number of jobs you can run in parallel.
#
#       --uppm <FILEPATH>
#            specify the path of uppm executable.
#
#       --urlmap <FILEPATH>
#            specify the path of urlmap executable.
#
#       --prefix <DIR>
#            specify the directory where files should be installed. default to ~/.fpliu/native/
#
#       --download-dir <DIR>
#            specify the directory where source files should be downloaded. default to ~/.fpliu/downloads/
#
#       --session-dir <DIR>
#            specify the directory where source files should be uncompressed. default to ~/.fpliu/run/$$
#
############################################################################

set -e

COLOR_RED='\033[0;31m'
COLOR_GREEN='\033[0;32m'
COLOR_YELLOW='\033[0;33m'
COLOR_BLUE='\033[0;94m'
COLOR_PURPLE='\033[0;35m'
COLOR_OFF='\033[0m'

echo() {
    printf '%b\n' "$*"
}

note() {
    printf '%b\n' "🔔  ${COLOR_YELLOW}npbuild : $*${COLOR_OFF}" >&2
}

warn() {
    printf '%b\n' "🔥  ${COLOR_YELLOW}npbuild : $*${COLOR_OFF}" >&2
}

success() {
    printf '%b\n' "✅  ${COLOR_GREEN}npbuild : $*${COLOR_OFF}" >&2
}

error() {
    printf '%b\n' "💔  ${COLOR_RED}npbuild : $*${COLOR_OFF}" >&2
}

abort() {
    EXIT_STATUS_CODE="$1"
    shift
    printf '%b\n' "💔  ${COLOR_RED}npbuild : $*${COLOR_OFF}" >&2
    exit "$EXIT_STATUS_CODE"
}

run() {
    echo "${COLOR_PURPLE}==>${COLOR_OFF} ${COLOR_GREEN}$*${COLOR_OFF}" >&2
    eval "$@"
}

isInteger() {
    case "${1#[+-]}" in
        (*[!0123456789]*) return 1 ;;
        ('')              return 1 ;;
        (*)               return 0 ;;
    esac
}

sha256sum_of_file() {
    sha256sum "$1" | cut -d ' ' -f1
}

sha256sum_of_str() {
    printf '%s\n' "$1" | sha256sum | cut -d ' ' -f1
}

filetype_from_url() {
    # remove query params
    URL="${1%%'?'*}"

    FNAME="${URL##*/}"

    case $FNAME in
        *.tar.gz|*.tgz)
            printf '%s\n' '.tgz'
            ;;
        *.tar.lz|*.tlz)
            printf '%s\n' '.tlz'
            ;;
        *.tar.xz|*.txz)
            printf '%s\n' '.txz'
            ;;
        *.tar.bz2|*.tbz2)
            printf '%s\n' '.tbz2'
            ;;
        *.*)printf '%s\n' ".${FNAME##*.}"
    esac
}

git_clone_depth_1() {
    if [ -z "$URLMAP" ] ; then
        URL="$1"
    else
        URL="$("$URLMAP" "$1")"
    fi

    shift

    run git clone --depth=1 "$URL" "$@"
}

__fetch_gnu_config() {
    for URL in 'https://github.com/leleliu008/gnu-config' 'https://git.savannah.gnu.org/git/config.git'
    do
        if [ -d    gnu ] ; then
            rm -rf gnu
        fi

        git_clone_depth_1 "$URL" gnu && return 0
    done
}

__update_gnu_config() {
    GNU_CONFIG_DIR="$SESSION_DIR/gnu"

    if [ ! -f "$GNU_CONFIG_DIR/config.sub" ] || [ ! -f "$GNU_CONFIG_DIR/config.guess" ] ; then
        run cd "$SESSION_DIR"

        __fetch_gnu_config

        run cd -
    fi

    for item in sub guess
    do
        find -type f -name "config.$item" -exec cp -vf "$GNU_CONFIG_DIR/config.$item" {} \;
    done
}

# wfetch <URL> [--uri=<URL-MIRROR>] [--sha256=<SHA256>] [-p <PACKAGE-NAME>] [-o <OUTPUT-PATH>] [-q] [--no-buffer]
#
# If -o <OUTPUT-PATH> option is unspecified, the result will be written to ./$(basename <URL>)
#
# If <OUTPUT-PATH> is -, then the result will be written to stdout.
#
# If <OUTPUT-PATH> is . .. or ends with slash(/), then it will be treated as a directory, otherwise, it will be treated as a filepath.
#
# If <OUTPUT-PATH> is treated as a directory, then it will be expanded to <OUTPUT-PATH>/$(basename <URL>)
#
# influential environment variable:
# URLMAP
wfetch() {
    unset FETCH_UTS
    unset FETCH_SHA

    unset FETCH_URL
    unset FETCH_URI

    unset FETCH_PATH

    unset FETCH_OUTPUT_DIR
    unset FETCH_OUTPUT_FILEPATH
    unset FETCH_OUTPUT_FILENAME

    unset FETCH_BUFFER_FILEPATH

    unset FETCH_SHA256_EXPECTED

    unset FETCH_SILENT

    unset NOT_BUFFER

    unset PKGNAME

    [ -z "$1" ] && abort 1 "wfetch <URL> [OPTION]... , <URL> must be non-empty."

    FETCH_URL="$1"

    shift

    while [ -n "$1" ]
    do
        case $1 in
            --uri=*)
                FETCH_URI="${1#*=}"
                ;;
            --sha256=*)
                FETCH_SHA256_EXPECTED="${1#*=}"
                ;;
            -o) shift
                if [ -z "$1" ] ; then
                    abort 1 "wfetch <URL> -o <PATH> , <PATH> must be non-empty."
                else
                    FETCH_PATH="$1"
                fi
                ;;
            -p) shift
                if [ -z "$1" ] ; then
                    abort 1 "wfetch <URL> -p <PKGNAME> , <PKGNAME> must be non-empty."
                else
                    PKGNAME="$1"
                fi
                ;;
            -q) FETCH_SILENT=1
                ;;
            --no-buffer)
                NOT_BUFFER=1
                ;;
            *)  abort 1 "wfetch <URL> [--uri=<URL-MIRROR>] [--sha256=<SHA256>] [-o <PATH>] [-q] , unknown argument: $1"
        esac
        shift
    done

    case $FETCH_PATH in
        -)
            FETCH_BUFFER_FILEPATH='-'
            ;;
        .|'')
            FETCH_OUTPUT_DIR='.'
            FETCH_OUTPUT_FILEPATH="$FETCH_OUTPUT_DIR/${FETCH_URL##*/}"
            ;;
        ..)
            FETCH_OUTPUT_DIR='..'
            FETCH_OUTPUT_FILEPATH="$FETCH_OUTPUT_DIR/${FETCH_URL##*/}"
            ;;
        */)
            FETCH_OUTPUT_DIR="${FETCH_PATH%/}"
            FETCH_OUTPUT_FILEPATH="$FETCH_OUTPUT_DIR/${FETCH_URL##*/}"
            ;;
        *)
            FETCH_OUTPUT_DIR="$(dirname "$FETCH_PATH")"
            FETCH_OUTPUT_FILEPATH="$FETCH_PATH"
    esac

    if [ -n "$FETCH_OUTPUT_FILEPATH" ] ; then
        if [ -f "$FETCH_OUTPUT_FILEPATH" ] ; then
            if [ -n "$FETCH_SHA256_EXPECTED" ] ; then
                if [ "$(sha256sum_of_file "$FETCH_OUTPUT_FILEPATH")" = "$FETCH_SHA256_EXPECTED" ] ; then
                    return 0
                fi
            fi
        fi

        if [ "$NOT_BUFFER" = 1 ] ; then
            FETCH_BUFFER_FILEPATH="$FETCH_OUTPUT_FILEPATH"
        else
            FETCH_UTS="$(date +%s)"

            FETCH_SHA="$(sha256sum_of_str "$FETCH_URL:$$:$FETCH_UTS")"

            FETCH_BUFFER_FILEPATH="$FETCH_OUTPUT_DIR/$FETCH_SHA.tmp"
        fi
    fi

    if [                -n "$FETCH_OUTPUT_DIR" ] ; then
        if [ !          -d "$FETCH_OUTPUT_DIR" ] ; then
            run install -d "$FETCH_OUTPUT_DIR" || return 1
        fi
    fi

    case $FETCH_TOOL in
        curl)
            FETCH_ARGS='--fail --retry 20 --retry-delay 30 --location'

            if [ "$FETCH_SILENT" = 1 ] ; then
                FETCH_ARGS="$FETCH_ARGS --no-progress-meter"
            fi

            if [ -n "$PPKG_DNS_SERVERS" ] ; then
                FETCH_ARGS="$FETCH_ARGS --dns-servers $PPKG_DNS_SERVERS"
            fi

            if [ -n "$SSL_CERT_FILE" ] ; then
                FETCH_ARGS="$FETCH_ARGS --cacert $SSL_CERT_FILE"
            fi

            FETCH_ARGS="$FETCH_ARGS -o '$FETCH_BUFFER_FILEPATH'"
            ;;
        wget)
            FETCH_ARGS="--timeout=60 -O '$FETCH_BUFFER_FILEPATH'"
            ;;
        http)
            FETCH_ARGS="--timeout=60 -o '$FETCH_BUFFER_FILEPATH'"
            ;;
        aria2c)
            FETCH_ARGS="-d '$FETCH_OUTPUT_DIR' -o '$FETCH_OUTPUT_FILENAME'"
            ;;
        axel)
            FETCH_ARGS="-o '$FETCH_BUFFER_FILEPATH'"
            ;;
        *)  abort 1 "wfetch() unimplementation: $FETCH_TOOL"
            ;;
    esac

    ORIGIN_FETCH_URL="$FETCH_URL"

    for i in 1 2 3 4 5 6 7 8
    do
        case $i in
            1)
                if [ -n "$URLMAP" ] ; then
                    FETCH_URL="$("$URLMAP" "$FETCH_URL")" || return 1
                fi

                if [ "$GITHUB_ACTIONS" = true ] ; then
                    case $FETCH_URL in
                        https://ftp.gnu.org/gnu/*)
                            FETCH_URL="$(printf '%s\n' "$FETCH_URL" | sed 's|ftp\.gnu\.org|mirrors.kernel.org|')"
                    esac
                fi
                ;;
            2)  if [ -z "$FETCH_URI" ] ; then
                     continue
                fi

                if [ -n "$URLMAP" ] ; then
                    FETCH_URL="$("$URLMAP" "$FETCH_URI")" || return 1
                else
                    FETCH_URL="$FETCH_URI"
                fi
                ;;
            3)  case $ORIGIN_FETCH_URL in
                    https://ftp.gnu.org/gnu/*)
                        FETCH_URL="$(printf '%s\n' "$FETCH_URL" | sed 's|ftp\.gnu\.org|mirrors.kernel.org|')"
                        ;;
                    *)  continue
                esac
                ;;
            4)
                FETCH_URX="${ORIGIN_FETCH_URL%%'?'*}"
                FILENAME="${FETCH_URX##*/}"
                FETCH_URL="https://fossies.org/linux/misc/$FILENAME"
                ;;
            5)  MACPORTS_PKGNAME=

                if [ -z "$PKGNAME" ] ; then
                    continue
                fi

                MACPORTS_PKGNAME="${PKGNAME%@*}"

                FETCH_URL="https://distfiles.macports.org/$MACPORTS_PKGNAME/$FILENAME"
                ;;
            6)  case $MACPORTS_PKGNAME in
                    '') continue ;;
                    lib)FETCH_URL="https://distfiles.macports.org/${MACPORTS_PKGNAME#lib}/$FILENAME" ;;
                    *)  FETCH_URL="https://distfiles.macports.org/lib$MACPORTS_PKGNAME/$FILENAME"
                esac
                ;;
            7)  case $FILENAME in
                    *-*)
                        MACPORTS_PKGNAME="${FILENAME%%-*}"
                        FETCH_URL="https://distfiles.macports.org/$MACPORTS_PKGNAME/$FILENAME"
                        ;;
                    *)  MACPORTS_PKGNAME=
                        continue
                esac
                ;;
            8)  case $MACPORTS_PKGNAME in
                    '') FETCH_URL= ; continue ;;
                    lib)FETCH_URL="https://distfiles.macports.org/${MACPORTS_PKGNAME#lib}/$FILENAME" ;;
                    *)  FETCH_URL="https://distfiles.macports.org/lib$MACPORTS_PKGNAME/$FILENAME"
                esac
                ;;
        esac

        run "$FETCH_TOOL $FETCH_ARGS '$FETCH_URL'" && break
    done

    [ $? -eq 0 ] || return 1

    if [ -n "$FETCH_OUTPUT_FILEPATH" ] ; then
        if [ -n "$FETCH_SHA256_EXPECTED" ] ; then
            FETCH_SHA256_ACTUAL="$(sha256sum_of_file "$FETCH_BUFFER_FILEPATH")"

            if [ "$FETCH_SHA256_ACTUAL" != "$FETCH_SHA256_EXPECTED" ] ; then
                abort 1 "sha256sum mismatch.\n    expect : $FETCH_SHA256_EXPECTED\n    actual : $FETCH_SHA256_ACTUAL\n"
            fi
        fi

        if [ "$NOT_BUFFER" != 1 ] ; then
            run mv "$FETCH_BUFFER_FILEPATH" "$FETCH_OUTPUT_FILEPATH"
        fi
    fi
}

