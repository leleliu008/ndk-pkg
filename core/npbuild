############################################################################

configure() {
    __update_gnu_config

    run ./configure "--prefix=$PACKAGE_INSTALL_DIR" "$@"
    run "$GMAKE" "--jobs=$NJOBS"
    run "$GMAKE" install
}

config() {
    run ./config "--prefix=$PACKAGE_INSTALL_DIR" "$@"
    run "$GMAKE" "--jobs=$NJOBS"
    run "$GMAKE" install_sw
}

perlmk() {
    run perl Makefile.PL "--prefix=$PACKAGE_INSTALL_DIR" "$@"
    run "$GMAKE" "--jobs=$NJOBS"
    run "$GMAKE" install
    run install -d "$PACKAGE_INSTALL_DIR"
}

cmakew() {
    export CMAKE_GENERATOR='Unix Makefiles'

    if [ -z "$CMAKE" ] ; then
        CMAKE="$(command -v cmake)" || abort 1 'command not found: cmake'
    fi

    run "$CMAKE" -DCMAKE_INSTALL_PREFIX=$PACKAGE_INSTALL_DIR -DENABLE_TESTING=OFF -DCMAKE_VERBOSE_MAKEFILE=ON -DCMAKE_BUILD_TYPE=Release "$@" -S . -B build.d
    run "$CMAKE" --build   build.d -- -j$NJOBS
    run "$CMAKE" --install build.d
}

gmakew() {
    run "$GMAKE" "$@"
}

############################################################################

install_the_given_package() {
    unset PACKAGE_SRC_URL
    unset PACKAGE_SRC_SHA

    unset PACKAGE_DEP_PKG
    unset PACKAGE_DEP_AUX

    unset PACKAGE_DOPATCH
    unset PACKAGE_INSTALL
    unset PACKAGE_DOTWEAK

    package_info_$1

    ###########################################

    for PACKAGE_DEPENDENCY in $PACKAGE_DEP_PKG
    do
        (install_the_given_package "$PACKAGE_DEPENDENCY")
    done

    ###########################################

    if [ -f "$PACKAGE_INSTALL_ROOT/$1/receipt.txt" ] ; then
        note "package '$1' already has been installed, skipped."
        return 0
    else
        note "package '$1' is being installed."
    fi

    ###########################################

    if [ -z "$PACKAGE_DEP_AUX" ] ; then
        PACKAGE_DEP_AUX='gmake'
    else
        PACKAGE_DEP_AUX="gmake $PACKAGE_DEP_AUX"
    fi

    ###########################################

    for UPPM_PACKAGE_NAME in $PACKAGE_DEP_AUX
    do
        run "$UPPM" install "$UPPM_PACKAGE_NAME" "$UPPM_INSTALL_ARGS"

        UPPM_PACKAGE_INSTALLED_DIR="$UPPM_HOME/installed/$UPPM_PACKAGE_NAME"

        for i in bin sbin shared/aclocal
        do
            d="$UPPM_PACKAGE_INSTALLED_DIR/$i"

            [ -d "$d" ] || continue

            case $i in
                bin|sbin)
                    PATH="$d:$PATH"
                    ;;
                shared/aclocal)
                    ACLOCAL_PATH="$d:$ACLOCAL_PATH"
                    ;;
            esac
        done
    done

    ###########################################

    PACKAGE_INSTALL_UTS="$(date +%s)"

    PACKAGE_INSTALL_SHA="$(
{
    sha256sum <<EOF
$1:$PACKAGE_SRC_URL:$$:$PACKAGE_INSTALL_UTS
EOF
} | cut -d ' ' -f1)"

    PACKAGE_INSTALL_DIR="$PACKAGE_INSTALL_ROOT/$PACKAGE_INSTALL_SHA"

    ###########################################

    for DEPENDENT_PACKAGE_NAME in $PACKAGE_DEP_PKG
    do
        DEPENDENT_PACKAGE_INSTALLED_DIR="$PACKAGE_INSTALL_ROOT/$DEPENDENT_PACKAGE_NAME"

        for i in bin sbin include lib lib/pkgconfig share/pkgconfig shared/aclocal
        do
            d="$DEPENDENT_PACKAGE_INSTALLED_DIR/$i"

            [ -d "$d" ] || continue

            case $i in
                bin|sbin)
                    PATH="$d:$PATH"
                    ;;
                include)
                    CPPFLAGS="-I$d $CPPFLAGS"
                    ;;
                lib)
                    LDFLAGS="-L$d -Wl,-rpath,$d $LDFLAGS"
                    ;;
                lib/pkgconfig)
                    PKG_CONFIG_PATH="$d:$PKG_CONFIG_PATH"
                    ;;
                share/pkgconfig)
                    PKG_CONFIG_PATH="$d:$PKG_CONFIG_PATH"
                    ;;
                shared/aclocal)
                    ACLOCAL_PATH="$d:$ACLOCAL_PATH"
                    ;;
            esac
        done
    done

    ###########################################

    export ACLOCAL_PATH
    export CPPFLAGS
    export LDFLAGS="-Wl,-rpath,$PACKAGE_INSTALL_DIR/lib $LDFLAGS"

    ###########################################

    PACKAGE_SRC_FILETYPE="$(filetype_from_url "$PACKAGE_SRC_URL")"
    PACKAGE_SRC_FILENAME="$PACKAGE_SRC_SHA$PACKAGE_SRC_FILETYPE"
    PACKAGE_SRC_FILEPATH="$DOWNLOAD_DIR/$PACKAGE_SRC_FILENAME"

    ###########################################

    wfetch "$PACKAGE_SRC_URL" --sha256="$PACKAGE_SRC_SHA" -o "$PACKAGE_SRC_FILEPATH"

    PACKAGE_WORKING_DIR="$SESSION_DIR/native/$1"

    run install -d "$PACKAGE_WORKING_DIR"
    run cd         "$PACKAGE_WORKING_DIR"

    run bsdtar xf "$PACKAGE_SRC_FILEPATH" --strip-components=1 --no-same-owner

    ##############################

    if [ -n  "$PACKAGE_DOPATCH" ] ; then
        eval "$PACKAGE_DOPATCH"
    fi

    ##############################

    if [ -z "$GMAKE" ] ; then
        GMAKE="$(command -v gmake)" || abort 1 "command not found: gmake"
    fi

    ##############################

    eval "$PACKAGE_INSTALL"

    run cd "$PACKAGE_INSTALL_DIR"

    ##############################

    if [ -n  "$PACKAGE_DOTWEAK" ] ; then
        eval "$PACKAGE_DOTWEAK"
    fi

    ##############################

    cat > toolchain.txt <<EOF
     CC='$CC'
    CXX='$CXX'
     AS='$AS'
     LD='$LD'
     AR='$AR'
 RANLIB='$RANLIB'
SYSROOT='$SYSROOT'
EOF

    ##############################

    cat > receipt.txt <<EOF
PACKAGE_SRC_URL='$PACKAGE_SRC_URL'
PACKAGE_SRC_SHA='$PACKAGE_SRC_SHA'

PACKAGE_DEP_PKG='$PACKAGE_DEP_PKG'
PACKAGE_DEP_AUX='$PACKAGE_DEP_AUX'

PACKAGE_DOPATCH='$PACKAGE_DOPATCH'
PACKAGE_DOTWEAK='$PACKAGE_DOTWEAK'
PACKAGE_INSTALL='$PACKAGE_INSTALL'
PACKAGE_INSTALL_UTS='$PACKAGE_INSTALL_UTS'
EOF

    ##############################

    run cd "$PACKAGE_INSTALL_ROOT"
    run ln -s -f -T "$PACKAGE_INSTALL_SHA" "$1"

    success "package '$1' has been successfully installed."
}

##################################################

for FETCH_TOOL in curl wget
do
    if command -v "$FETCH_TOOL" > /dev/null ; then
        break
    else
        unset FETCH_TOOL
    fi
done

if [ -z "$FETCH_TOOL" ] ; then
    abort 1 "neither curl nor wget was found, please install one of them then try again."
fi

##################################################

unset NJOBS

unset URLMAP

unset SYSPM
unset UPPM

unset SESSION_DIR
unset DOWNLOAD_DIR
unset PACKAGE_INSTALL_ROOT

while [ -n "$1" ]
do
    case $1 in
        -j) shift
            isInteger "$1" || abort 1 "-j <N>, <N> should be an integer."
            NJOBS="$1"
            ;;
        --syspm)
            shift
            SYSPM="$1"
            ;;
        --uppm)
            shift
            UPPM="$1"
            ;;
        --urlmap)
            shift
            URLMAP="$1"
            ;;
        --prefix)
            shift
            PACKAGE_INSTALL_ROOT="$1"
            ;;
        --session-dir)
            shift
            SESSION_DIR="$1"
            ;;
        --download-dir)
            shift
            DOWNLOAD_DIR="$1"
            ;;
        --) shift
            break
            ;;
        -)  abort 1 "unrecognized argument: $1"
            ;;
        *)  break
    esac

    shift
done

: "${PACKAGE_INSTALL_ROOT:="$HOME/.fpliu/native"}"
: "${DOWNLOAD_DIR:="$HOME/.fpliu/downloads"}"
: "${SESSION_DIR:="$HOME/.fpliu/run/$$"}"
: "${UPPM:=uppm}"

##################################################

NATIVE_PLATFORM_TYPE="$(uname -s)"
NATIVE_PLATFORM_ARCH="$(uname -m)"

##################################################

if [ -z "$NJOBS" ] ; then
    if [ "$NATIVE_PLATFORM_TYPE" = Darwin ] ; then
        NJOBS="$(sysctl -n machdep.cpu.thread_count)"
    else
        if command -v nproc > /dev/null ; then
            NJOBS="$(nproc)"
        else
            NJOBS=1
        fi
    fi
fi

##################################################

if [ -z "$UPPM_HOME" ] ; then
    if [ -z "$HOME" ] ; then
        abort 1 "HOME environment variable is not set."
    else
        export UPPM_HOME="$HOME/.uppm"
    fi
fi

##################################################

unset PKG_CONFIG_LIBDIR

##################################################

for PKGNAME in "$@"
do
    install_the_given_package "$PKGNAME"
done
